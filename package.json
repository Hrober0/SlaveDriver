{
  "name": "slavedriver",
  "version": "0.1.0",
  "description": "Desktop overlay: a physics whip glued to your cursor for motivating hard-working LLM agents.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm run build",
    "start": "npm run build && node scripts/start.js",
    "start:target": "npm run build && node scripts/start.js --show-target"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  }
}
